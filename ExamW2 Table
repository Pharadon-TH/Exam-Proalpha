/* Table - 12 */

define stream stReport.

output stream stReport to 'D:/Work/stReport.csv':U.
put    stream stReport unformatted 'Artikel;Bezeichnung1;ArtikleArt;Lieferant;Name1':U skip.

/* loop check S_Artikel */
for each S_Artikel
  where S_Artikel.Firma    = {firma/sartikel.fir '100':U}
  no-lock:

  /* check ArtikelArt condition in list */
  if lookup(string(S_Artikel.ArtikelArt), "0,1,10,15") = 0 then
  do:

    /* check Kunde not have relation in Artikel */
    find first S_ArtKunde
      where S_ArtKunde.Firma   = {firma/sartkund.fir '100':U}
        and S_ArtKunde.Artikel = S_Artikel.Artikel
      no-lock no-error.

      if not available S_ArtKunde then
      do:

        /* check have Lieferant */
        find first E_Artlief
          where E_Artlief.Firma      = {firma/e_artli.fir '100':U}
            and E_Artlief.Artikel = S_Artikel.Artikel
          no-lock no-error.

          /* Retrieve supplier in relation */
          if available E_Artlief then
          do:
            find first S_Lieferant
              where S_Lieferant.Firma      = {firma/sliefera.fir '100':U}
                and S_Lieferant.Lieferant  = E_Artlief.Lieferant
              no-lock no-error.

              if available S_ArtikelSpr then
                S_ArtikelSpr.Bezeichnung[1].
              else
                "".
            
            /* check name S_Lieferant */
            find first S_Adresse
              where S_Adresse.Firma     = {firma/s_adres.fir '100':U}
                and S_Adresse.AdressNr  = S_Lieferant.AdressNr
              no-lock no-error.

              if available S_Adresse then
                S_Adresse.Name1.
              else
                "".
            
            /* find description1 in S_ArtikelSpr */
            find first S_ArtikelSpr
              where S_ArtikelSpr.Firma    = {firma/sartikel.fir '100':U}
                and S_ArtikelSpr.Artikel = S_Artikel.Artikel
              no-lock no-error.

              if available S_ArtikelSpr then
                S_Artikel.ArtikelArt.
              else
                "".
            /* Result */
            export stream stReport delimiter ";"
              S_Artikel.Artikel
              S_ArtikelSpr.Bezeichnung[1]
              S_Artikel.ArtikelArt
              E_Artlief.Lieferant
              S_Adresse.Name1.

          end. /* if available E_Artlief */
      end. /* if not available S_ArtKunde */
  end. /* if lookup */
end. /* for each S_Artikel */

output stream stReport close.
message 'Export CSV via Stream Complete'
        view-as alert-box.
        

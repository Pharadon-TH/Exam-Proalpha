              else
                "".
            
            /* check name S_Lieferant */
            find first S_Adresse
              where S_Adresse.Firma     = {firma/s_adres.fir '100':U}
                and S_Adresse.AdressNr  = S_Lieferant.AdressNr
              no-lock no-error.

              if available S_Adresse then
                S_Adresse.Name1.
              else
                "".
            
            /* find description1 in S_ArtikelSpr */
            find first S_ArtikelSpr
              where S_ArtikelSpr.Firma    = {firma/sartikel.fir '100':U}
                and S_ArtikelSpr.Artikel = S_Artikel.Artikel
              no-lock no-error.

              if available S_ArtikelSpr then
                S_Artikel.ArtikelArt.
              else
                "".
            /* Result */
            export stream stReport delimiter ";"
              S_Artikel.Artikel
              S_ArtikelSpr.Bezeichnung[1]
              S_Artikel.ArtikelArt
              E_Artlief.Lieferant
              S_Adresse.Name1.

          end. /* if available E_Artlief */
      end. /* if not available S_ArtKunde */

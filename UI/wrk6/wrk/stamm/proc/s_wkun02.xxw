&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK Include
   
      
&IF DEFINED(DEFINITION) = 2 or defined (PA-XBASISNAME) = 0 &THEN

define temp-table ttS_KundeStatus no-undo
  field rId            as rowid
  field lOriginalValue as logical initial yes
  index rId is primary rId.
  
define variable lOriginal    as logical no-undo.
define variable lOldOriginal as logical no-undo.

&ENDIF /* DEFINITION */   
      
&IF DEFINED(DM_SMA00_MAIN) = 2 or defined (PA-XBASISNAME) = 0 &THEN

  /* add Fields to a Viewer */
  {adm/template/incl/dt_ind01.if
    &Field1     = "lOriginal"
    &Pred1      = "gcInvoiceRecipient"
    &TabPred1   = "gcInvoiceRecipient"
    &Label1     = "label 'Original'"
    &View-as1   = "view-as toggle-box"
    ...
  }
  
  /* Scale up Frame
  {adm/template/incl/dt_ind05.if
    &Function   = "Resize-Frame"
    &Frame-Name = "{&FRAME-NAME}"
    &ColDelta   = "0"
    &RowDelta   = "1.25"
  }
  */

&ENDIF /* DM_SMA00_MAIN */   
      
&IF DEFINED(PA_CCAPIGETINTERNALPROPERTY) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* pa_cCAPIGetInternalProperty */   
      
&IF DEFINED(SEND-WINDOW-TITLE_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* SEND-WINDOW-TITLE_NACHLAUF */   
      
&IF DEFINED(MAIN) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* Main */   
      
&IF DEFINED(INITIALIZE_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* Initialize_Vorlauf */   
      
&IF DEFINED(INITIALIZE_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* Initialize_Nachlauf */   
      
&IF DEFINED(SETUP_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* Setup_Vorlauf */   
      
&IF DEFINED(SETUP_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* Setup_Nachlauf */   
      
&IF DEFINED(DISPLAY-FIELDS_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN

if available S_Kunde then
do:
  find first ttS_KundeStatus
    where ttS_KundeStatus.rId = rowid(S_Kunde)
    no-lock no-error.
    
  if not available ttS_KundeStatus then
  do:
    create ttS_KundeStatus.
    assign
      ttS_KundeStatus.rId            = rowid(S_Kunde)
      ttS_KundeStatus.lOriginalValue = yes
      .
  end. /* if not available ttS_KundeStatus */

  assign
    lOriginal    = ttS_KundeStatus.lOriginalValue
    lOldOriginal = ttS_KundeStatus.lOriginalValue. /* Remember the original value to check when saving */

end. /* if available S_Kunde */


&ENDIF /* DISPLAY-FIELDS_VORLAUF */   
      
&IF DEFINED(DISPLAY-FIELDS_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* DISPLAY-FIELDS_NACHLAUF */   
      
&IF DEFINED(ADD-RECORD_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* ADD-RECORD_VORLAUF */   
      
&IF DEFINED(ADD-RECORD_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* ADD-RECORD_NACHLAUF */   
      
&IF DEFINED(ASSIGN-RECORD_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN



&ENDIF /* ASSIGN-RECORD_VORLAUF */   
      
&IF DEFINED(ASSIGN-RECORD_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN

if available S_Kunde then
do:

  /* Check customer's staat, must be DE only */
  if S_Kunde.Staat <> "D" then
  do:
    adm.method.cls.DMCMessageSvc:prpoInstance:showError
    ('s_kun00004':U,
     'Warning':U).
  end.

  assign
    lOriginal = lOriginal.
    
  /* Users are prohibited from secretly changing their status from YES - > NO  */
  if lOldOriginal = yes and lOriginal = no then
  do:
    adm.method.cls.DMCMessageSvc:prpoInstance:showError
    ('s_kun00005':U,
     'Warning':U).
  end.
  
  /* user edit check box status = no */
  if lOldOriginal = yes and lOriginal = yes then
  do:
    lOriginal = no.
  end.
  
  /* Save the most recently concluded values back into the Temp-Table */
  find first ttS_KundeStatus
    where ttS_KundeStatus.rId = rowid(S_Kunde)
    no-lock no-error.
    
  if available ttS_KundeStatus THEN
  do:
    ttS_KundeStatus.lOriginalValue = lOriginal.
  end.
end. /* if available S_Kunde */
 
&ENDIF /* ASSIGN-RECORD_NACHLAUF */   
      
&IF DEFINED(ASSIGN-STATEMENT_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* ASSIGN-STATEMENT_VORLAUF */   
      
&IF DEFINED(ASSIGN-STATEMENT_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* assign-statement_Nachlauf */   
      

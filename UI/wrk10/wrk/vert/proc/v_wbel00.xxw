&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK Include
   
      
&IF DEFINED(DEFINITION) = 2 or defined (PA-XBASISNAME) = 0 &THEN

define variable cCountPos as character no-undo.
define variable iCount    as integer   no-undo.
define variable iACM      as integer   no-undo.

&ENDIF /* DEFINITION */   
      
&IF DEFINED(DM_SMA00_MAIN) = 2 or defined (PA-XBASISNAME) = 0 &THEN

  /* add Fields to a Viewer */
  {adm/template/incl/dt_ind01.if
    &Frame-Name = "F-Main"
    &Field1     = "cCountPos"
    &Pred1      = "VBM_PreConfigVariant_Obj"
    &TabPred1   = "VBM_PreConfigVariant_Obj"
    &Label1     = "label 'Cout Pos.'"
    ...
  }

  /* Scale up Frame
  {adm/template/incl/dt_ind05.if
    &Function   = "Resize-Frame"
    &Frame-Name = "{&FRAME-NAME}"
    &ColDelta   = "0"
    &RowDelta   = "1.25"
  }
  */

&ENDIF /* DM_SMA00_MAIN */   
      
&IF DEFINED(PA_CCAPIGETINTERNALPROPERTY) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* pa_cCAPIGetInternalProperty */   
      
&IF DEFINED(SEND-WINDOW-TITLE_NACHLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN


&ENDIF /* SEND-WINDOW-TITLE_NACHLAUF */   
      
&IF DEFINED(MAIN) = 2 or defined (PA-XBASISNAME) = 0 &THEN

PROCEDURE pPositions:

  if available V_BelegKopf then
  do:
    for each V_BelegPos
      where V_BelegPos.Firma       = {firma/vbelegko.fir '100':U}
        and V_BelegPos.BelegArt     = V_BelegKopf.BelegArt
        and V_BelegPos.ReferenzNr   = V_BelegKopf.ReferenzNr
        and V_BelegPos.LfdNr_SR     = 0
      no-lock:

      iCount = iCount + 1.

    end.

    assign
      cCountPos = string(iCount)
      iCount    = 0
      cCountPos:screen-value in frame F-Main = cCountPos
      iACM = adm.config.cls.DCCAppConfigSvc:prpoInstance:iParameterValue('X_ArftargCountPos':U)
      .

    if integer(cCountPos) > iACM then
      adm.method.cls.DMCUISvc:SetWidgetColor
      (cCountPos:handle in frame F-Main,
       'bgcolor':U,
       'DM_ColorPool_red_1':U).
  end.
  
END PROCEDURE.

&ENDIF /* Main */   
      
&IF DEFINED(INITIALIZE_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN



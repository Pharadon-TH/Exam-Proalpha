when 'ArtLiefFunction':U then
do:
  find first E_ArtLief
    where E_ArtLief.Firma      = {firma/e_artli.fir '100' }
      and E_ArtLief.Lieferant  = E_BelegKopf.Lieferant
    no-lock no-error.
  if available E_ArtLief then
    return yes.
  else
    return no.
end.



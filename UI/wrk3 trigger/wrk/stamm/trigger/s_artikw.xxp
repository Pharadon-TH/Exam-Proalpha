&IF DEFINED(NEUANLAGE) = 2 or defined (PA-XBASISNAME) = 0 &THEN

find first XS_ArtGroup
  where XS_ArtGroup.Firma        = '100'
    and XS_ArtGroup.Artikel      = S_Artikel.Artikel
  exclusive-lock no-error.

/* if no data */
if not available XS_ArtGroup then
do:

  create XS_ArtGroup.

  buffer-copy
    S_Artikel
  except
    S_Artikel.S_Artikel_Obj
  to
    XS_ArtGroup.

  assign
    XS_ArtGroup.GroupNumber = substring(S_Artikel.Artikel , 1, 1)
    .
end. /* if not available XS_ArtGroup */

&ENDIF /* Neuanlage */   
      

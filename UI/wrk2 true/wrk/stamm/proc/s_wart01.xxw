&IF DEFINED(DISPLAY-FIELDS_VORLAUF) = 2 or defined (PA-XBASISNAME) = 0 &THEN

IF AVAILABLE S_Artikel THEN
DO:
  IF S_Artikel.Gewicht >= 50 THEN
    ASSIGN cStatusWeight = "Overweight".
  ELSE IF S_Artikel.Gewicht < 50 and S_Artikel.Gewicht > 0 THEN
    ASSIGN cStatusWeight = "Normal".
  ELSE IF S_Artikel.Gewicht = 0 THEN
    ASSIGN cStatusWeight = "Zero".
END.


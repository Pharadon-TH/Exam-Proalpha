/*------------------ Sale 4 ------------------*/

/*
Display all Artikel positions for all documents of the type Auftrag, calculate the total price for each position, and dis-play the total for each document.
Example:
BelegNr 10200419
position 1 -> Einzelpreis: 47.53 ,menge: 242
                        totalPrice = 47.53 * 242 = 11502.26
position 2 -> Einzelpreis: 45.59 ,menge: 193
                        totalPrice = 11502.26 + (45.59*193) = 20301.13
*/
current-window:width = 120.

define variable dTotalPrice as decimal format '-zzz,zzz,zz9.99' no-undo.

for each V_BelegKopf
  where V_BelegKopf.Firma       = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
    and V_BelegKopf.BelegArt    = 'U':U
  no-lock:
  
  assign
    dTotalPrice = 0
    .

  for each V_BelegPos
    where V_BelegPos.Firma        = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
      and V_BelegPos.BelegArt     = V_BelegKopf.BelegArt
      and V_BelegPos.ReferenzNr   = V_BelegKopf.ReferenzNr
      and V_BelegPos.LfdNr_SR     = 0
    no-lock:

    dTotalPrice = (V_BelegPos.Einzelpreis * V_BelegPos.Menge) + dTotalPrice.

    display
      V_BelegPos.BelegNummer
      V_BelegPos.BelegArt
      V_BelegPos.PositionsNr
      V_BelegPos.Artikel
      V_BelegPos.Einzelpreis
      V_BelegPos.Menge
      dTotalPrice
      with frame fTotal width 120 down.
  end.
end.


/*------------------ Sale 5 ------------------*/

/*
All Angebot positions are adopted to Auftrag
adopted = This document refers to previous documents, such as type U. If it refers to document A, it means adoption has happened.
Display: KundeNr,Name1,Belegnummer(A),Belegnummer(U),Position,Artikel,ArtikelBez1, adoption (yes/no)
Adoption: yes = this position adopt to Auftrag, no = this position doesn’t adoption
*/

current-window:width = 180.

define buffer bV_BelegPos for V_BelegPos.

define variable cBelegA      as character format "x(15)" no-undo.
define variable cBelegU      as character format "x(15)" no-undo.
define variable cAdoption    as character format "x(3)"  no-undo.

/* loop Header A */
for each V_BelegKopf
  where V_BelegKopf.Firma    = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
    and V_BelegKopf.BelegArt = 'A':U
  no-lock:
    
  /* loop Poosition and check Artikel */
  for each V_BelegPos
    where V_BelegPos.Firma      = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
      and V_BelegPos.BelegArt   = V_BelegKopf.BelegArt
      and V_BelegPos.ReferenzNr = V_BelegKopf.ReferenzNr
    no-lock:

    /* reset Position and check Artikel */
    assign
      cBelegA      = string(V_BelegPos.BelegNummer)
      cBelegU      = '-':U
      cAdoption    = 'no':U
      .

    /* check Adoption Connect with U */
    find first bV_BelegPos
      where bV_BelegPos.Firma            = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
        and bV_BelegPos.BelegArt         = 'U':U
        and bV_BelegPos.Herk_BelegArt    = V_BelegPos.BelegArt
        and bV_BelegPos.Herk_ReferenzNr  = V_BelegPos.ReferenzNr
        and bV_BelegPos.Herk_PositionsNr = V_BelegPos.PositionsNr
      no-lock no-error.

    if available bV_BelegPos then
      assign
        cBelegU   = string(bV_BelegPos.BelegNummer)
        cAdoption = 'yes':U
        .
        
    /* check id and name Kunde */
    find S_Kunde
      where S_Kunde.Firma = {firma/s_kunde.fir pACConnectionSvc:prpcCompany}
        and S_Kunde.Kunde = V_BelegKopf.Kunde
      no-lock no-error.

    if available S_Kunde then
    do:
      find S_Adresse
        where S_Adresse.Firma    = {firma/s_adres.fir pACConnectionSvc:prpcCompany}
          and S_Adresse.AdressNr = S_Kunde.AdressNr
        no-lock no-error.

      if available S_Adresse then
          S_Adresse.Name1.
          
    end. /* if available S_Kunde */

    /* check description S_ArtikelSpr */
    find S_ArtikelSpr
      where S_ArtikelSpr.Firma   = {firma/sartikel.fir pACConnectionSvc:prpcCompany}
        and S_ArtikelSpr.Artikel = V_BelegPos.Artikel
        and S_ArtikelSpr.Sprache = 'D':U
      no-lock no-error.

    if available S_ArtikelSpr then
      S_ArtikelSpr.Bezeichnung[1].

    /* display Result */
    display
      V_BelegKopf.Kunde           column-label 'Kunde':U
      S_Adresse.Name1             column-label 'Name':U
      cBelegA                     column-label 'BelegNr(A)':U
      cBelegU                     column-label 'BelegNr(U)':U
      cAdoption                   column-label 'Adoption':U
      V_BelegPos.PositionsNr      column-label 'Pos':U
      V_BelegPos.Artikel          column-label 'Teil':U
      S_ArtikelSpr.Bezeichnung[1] column-label 'Bezeichnung':U
      with width 180 down.

  end. /* for each V_BelegPos */
end. /* for each V_BelegKopf */


/*------------------ Sale 2 ------------------*/

/*
Display all Artikel position for All open documenAktiont that type = Rechnung
Display fields:  document type (BelegArt), document number (Belegnummer) the positons Number (PositionsNr), and the document items (Artikel).
*/

for each V_BelegKopf
  where V_BelegKopf.Firma       = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
    and V_BelegKopf.BelegArt    = 'R'
    and V_BelegKopf.offen       = true
  no-lock:

  for each V_BelegPos
     where V_BelegPos.Firma      = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
      and V_BelegPos.BelegArt    = V_BelegKopf.BelegArt
      and V_BelegPos.ReferenzNr  = V_BelegKopf.ReferenzNr
      and V_BelegPos.offen       = true
    no-lock
    on error undo, throw:

  display
    V_BelegPos.BelegArt
    V_BelegPos.BelegNummer
    V_BelegPos.PositionsNr
    V_BelegPos.Artikel
    .
  end.
end.

/*------------------ Sale 3 ------------------*/

/*
Display all Artikel position for all document that type = Auftrag and show the price of each Artikel
Display fields:  the document type (BelegArt), the positons Number (PositionsNr), the document items (Artikel), and the price of each items (Einzelpreis)

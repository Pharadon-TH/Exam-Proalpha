/*------------------ Sale 8 ------------------*/

/*
Find a redundant artikel position in the same BelegNummer for all document in document type = Angebot, Auftrag, Lieferschien and rechnung
Display fields: document number (BelegNummer) and the positions of the redundant item (artikel).
It should display both the original artikel position and the redundant artikel position.
For example, the document type angebot no. 10100136 contains five elements, two of which have the same artikel.
We should show all the positions, such as 4,5
*/

define temp-table ttRedundant no-undo
  field BelegArt    like V_BelegKopf.BelegArt
  field BelegNummer like V_BelegKopf.BelegNummer
  field Artikel     like V_BelegPos.Artikel
  field Positions   as character format 'x(30)' label 'PositionNr'
  field ItemCount   as integer

  index main is unique
  BelegArt
  Artikel
  BelegNummer
  .

/* loop check Header A,U,L,R */
for each V_BelegKopf
  where V_BelegKopf.Firma       = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
    and lookup(V_BelegKopf.BelegArt, 'A,U,L,R') > 0
  no-lock:

  /* loop check all Position*/
  for each V_BelegPos
    where V_BelegPos.Firma        = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
      and V_BelegPos.BelegArt     = V_BelegKopf.BelegArt
      and V_BelegPos.ReferenzNr   = V_BelegKopf.ReferenzNr
      and V_BelegPos.WertPosition <> yes
    no-lock:

    /* check table have data Artikel */
    find first ttRedundant
      where ttRedundant.BelegArt    = V_BelegPos.BelegArt
        and ttRedundant.BelegNummer = V_BelegPos.BelegNummer
        and ttRedundant.Artikel     = V_BelegPos.Artikel
      no-lock no-error.

    /* if not have table */
    if not available ttRedundant then
    do:
      create ttRedundant.
      assign
        ttRedundant.BelegArt    = V_BelegPos.BelegArt
        ttRedundant.BelegNummer = V_BelegPos.BelegNummer
        ttRedundant.Artikel     = V_BelegPos.Artikel
        ttRedundant.Positions   = string(V_BelegPos.PositionsNr)
        ttRedundant.ItemCount   = 1
        .
    end. /* if not available ttRedundant */

    /* if have table */
    else
      assign
        ttRedundant.Positions = ttRedundant.Positions + ',' + string(V_BelegPos.PositionsNr)
        ttRedundant.ItemCount = ttRedundant.ItemCount + 1
        .

  end. /* for each V_BelegPos */
end. /* for each V_BelegKopf */

/* condition ItemCount > 1 and display */
for each ttRedundant
  break by ttRedundant.BelegNummer:
  if ttRedundant.ItemCount > 1 then
    display
      ttRedundant.BelegNummer
      ttRedundant.Artikel
      ttRedundant.Positions
      with width 100 down.

end. /* for each ttRedundant */

/*------------------ Sale 9 ------------------*/

/*
Calculate total price (Menge * Einzelpreis) for each document where Belegart = U and group by month and year
You can look for the date of each document in the field belegDatum
*/

define stream stSale9.

output stream stSale9 to 'D:/Work/Sale-9.csv'.
put stream stSale9 unformatted 'mount;year;mounth;yearTotal' skip.

define temp-table ttMonthlySales no-undo
  field iYear        as integer
  field iMonth       as integer
  field dMonthTot    as decimal

  index mian is primary
    iYear
    iMonth
    .

define variable dYearAcc  as decimal no-undo.
define variable iLastYear as integer no-undo.

/* loop check Header doc type U */
for each V_BelegKopf
  where V_BelegKopf.Firma    = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
    and V_BelegKopf.BelegArt = 'U'
  no-lock:

  /* check position */
  for each V_BelegPos
    where V_BelegPos.Firma        = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
      and V_BelegPos.BelegArt     = V_BelegKopf.BelegArt
      and V_BelegPos.ReferenzNr   = V_BelegKopf.ReferenzNr
    no-lock:

    /* check data year and month in table? */
    find first ttMonthlySales
      where ttMonthlySales.iYear  = year(V_BelegKopf.BelegDatum)
        and ttMonthlySales.iMonth = month(V_BelegKopf.BelegDatum)
      no-lock no-error.

    /* if not have. create table */
    if not available ttMonthlySales then
    do:
      create ttMonthlySales.
      assign
        ttMonthlySales.iYear     = year(V_BelegKopf.BelegDatum)
        ttMonthlySales.iMonth    = month(V_BelegKopf.BelegDatum)
        ttMonthlySales.dMonthTot = 0
        .
    end. /* if not available ttMonthlySales */

    ttMonthlySales.dMonthTot = ttMonthlySales.dMonthTot + (V_BelegPos.Menge * V_BelegPos.Einzelpreis).

  end. /* for each V_BelegPos */
end. /* for each V_BelegKopf */

/* loop calculation price */
for each ttMonthlySales
  break by ttMonthlySales.iYear by ttMonthlySales.iMonth:

  if iLastYear <> ttMonthlySales.iYear then
    assign
      dYearAcc  = 0
      iLastYear = ttMonthlySales.iYear
      .

  dYearAcc = dYearAcc + ttMonthlySales.dMonthTot.

  put stream stSale9 unformatted
    ttMonthlySales.iMonth ';'
    ttMonthlySales.iYear ';'
    replace(string(ttMonthlySales.dMonthTot, '-zzzzzzzzz9.99'), '.', ',') ';'
    replace(string(dYearAcc, '-zzzzzzzzzz9.99'), '.', ',') skip.
end. /* for each ttMonthlySales */

output stream stSale9 close.

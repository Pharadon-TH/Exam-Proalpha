/*------------------ Sale 1 ------------------*/

/*
Display all documents in all document type in following order (Angebot,Auftrag,Lieferschein,Rechnung,Gutschrift)
Display fields: the document type (BelegArt), the document number (BelegNummer) , and the reference number (Refer-enzNr).
*/

for each V_BelegKopf
  where V_BelegKopf.Firma       = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
    and lookup(V_BelegKopf.BelegArt, 'A,U,L,R,G') > 0

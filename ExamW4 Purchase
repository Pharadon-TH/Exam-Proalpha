/*------------------ Purchase 3 (Version: Loop from EB) ------------------*/

/*
find all documents Bestellung link to Auftrag.
Export csv file -> BelegNr(EB);Lieferant;Lieferant Name1;BelegNr(U);Kunde;Kunde Name1
*/

define stream stPurchase3.

define buffer bS_Adresse_Lief for S_Adresse.
define buffer bS_Adresse_Kund for S_Adresse.

define variable cLief  as character no-undo.
define variable cKunde as character no-undo.

output stream stPurchase3 to 'D:/Work/Purchase-3test3.csv'.
put stream stPurchase3 unformatted 'BelegNr(EB);Lieferant;Lieferant Name1;BelegNr(U);Kunde;Kunde Name1':U skip.

/* loop check doc type EB */
for each E_BelegKopf
  where E_BelegKopf.Firma    = {firma/ebelkop.fir pACConnectionSvc:prpcCompany}
    and E_BelegKopf.BelegArt = 'EB'
  no-lock:

  /* loop check Position */
  for each E_BelegPos
    where E_BelegPos.Firma      = {firma/ebelkop.fir pACConnectionSvc:prpcCompany}
      and E_BelegPos.BelegArt   = E_BelegKopf.BelegArt
      and E_BelegPos.ReferenzNr = E_BelegKopf.ReferenzNr
    no-lock:

    /* Bestellung link to Auftrag */
    if E_BelegPos.Coverage_MRPDocType = 'U' then
    do:
    
      find V_BelegPos
        where V_BelegPos.V_BelegPos_Obj = E_BelegPos.Coverage_Obj
        no-lock no-error.

      if available V_BelegPos then
      do:

        find V_BelegKopf
          where V_BelegKopf.Firma      = {firma/vbelegko.fir pACConnectionSvc:prpcCompany}
            and V_BelegKopf.BelegArt   = V_BelegPos.BelegArt
            and V_BelegKopf.ReferenzNr = V_BelegPos.ReferenzNr
          no-lock no-error.


        if available V_BelegKopf then
        do:
        
          /* find id name S_Lieferant */
          find S_Lieferant
            where S_Lieferant.Firma     ={firma/sliefera.fir pACConnectionSvc:prpcCompany}
              and S_Lieferant.Lieferant = E_BelegKopf.Lieferant
            no-lock no-error.
              
          if available S_Lieferant then
          do:
            find bS_Adresse_Lief
              where bS_Adresse_Lief.Firma   = {firma/s_adres.fir pACConnectionSvc:prpcCompany}
                and bS_Adresse_Lief.AdressNr = S_Lieferant.AdressNr
              no-lock no-error.
                
            if available bS_Adresse_Lief then
              cLief = bS_Adresse_Lief.Name1.
            else
              cLief = 'Unknown'.
             
          end.

          /* find id name S_Kunde */
          find S_Kunde
            where S_Kunde.Firma = {firma/s_kunde.fir pACConnectionSvc:prpcCompany}
              and S_Kunde.Kunde = V_BelegKopf.Kunde
            no-lock no-error.
            
          if available S_Kunde then
          do:
            find bS_Adresse_Kund
              where bS_Adresse_Kund.Firma    =  {firma/s_adres.fir pACConnectionSvc:prpcCompany}
                and bS_Adresse_Kund.AdressNr = S_Kunde.AdressNr
              no-lock no-error.
                
            if available bS_Adresse_Kund then
              cKunde = bS_Adresse_Kund.Name1.
            else
              cKunde = 'Unknown'.
          end.

          put stream stPurchase3 unformatted
            E_BelegKopf.BelegNummer ";"
            E_BelegKopf.Lieferant   ";"
            cLief                   ";"
            V_BelegKopf.BelegNummer ";"
            V_BelegKopf.Kunde       ";"
            cKunde
            skip.
              
        end. /* if avail V_BelegKopf */
      end. /* if avail V_BelegPos */
    end. /* if Coverage_MRPDocType = 'U' */
  end. /* for each E_BelegPos */
end. /* for each E_BelegKopf */

output stream stPurchase3 close.
message 'Export Purchase-3 Complete'
        view-as alert-box information.
        
